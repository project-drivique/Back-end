# Spring Boot does not load this file automatically. Export values before running Maven.
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drivique_dev
DB_USERNAME=drivique
DB_PASSWORD=
# Optional: overrides DB_HOST, DB_PORT and DB_NAME when exported.
# DB_URL=jdbc:postgresql://localhost:5432/drivique_dev
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Orígenes web permitidos, separados por coma. Obligatorio en qa y main.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Correo transaccional de Gmail. La contraseña debe ser una contraseña de aplicación
# de 16 caracteres, sin espacios. Nunca guardar la contraseña real en Git.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@example.com
SPRING_MAIL_PASSWORD=your-16-character-app-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
APP_AUTH_MAIL_FROM=no-reply@example.com
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:5173
# Secretos: minimo 32 caracteres aleatorios (openssl rand -base64 48). Obligatorios en todos los entornos.
APP_DOCUMENT_ENCRYPTION_KEY=generate-with-openssl-rand-base64-48
JWT_SECRET=generate-with-openssl-rand-base64-48

# Contrasenas reales del super admin y de los 6 encargados (minimo 12 caracteres). No hay contrasena por defecto.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_BRANCH_ADMIN_PASSWORD=

# Captcha (Cloudflare Turnstile). En desarrollo, vacio = claves de prueba que siempre aprueban.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Pasarela Wompi (definir llaves desde el entorno seguro, nunca subir valores reales)
WOMPI_PUBLIC_KEY=your-wompi-public-key
WOMPI_INTEGRITY_SECRET=your-wompi-integrity-secret
WOMPI_EVENT_SECRET=your-wompi-event-secret
WOMPI_API_URL=https://sandbox.wompi.co/v1
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
