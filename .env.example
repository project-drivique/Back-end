# Spring Boot does not load this file automatically. Export values before running Maven.
SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drivique_dev
DB_USERNAME=drivique
DB_PASSWORD=
# Optional: overrides DB_HOST, DB_PORT and DB_NAME when exported.
# DB_URL=jdbc:postgresql://localhost:5432/drivique_dev
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Orígenes web permitidos, separados por coma. Obligatorio en qa y main.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Correo transaccional: usar credenciales SMTP del entorno, nunca subir secretos.
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS=true
APP_AUTH_MAIL_FROM=no-reply@drivique.com
